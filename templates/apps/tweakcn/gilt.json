{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "Gilt",
  "cssVars": {
    "theme": {
      "font-sans": "ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, 'Noto Sans', sans-serif, 'Apple Color Emoji', 'Segoe UI Emoji', 'Segoe UI Symbol', 'Noto Color Emoji'",
      "font-mono": "ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, \"Liberation Mono\", \"Courier New\", monospace",
      "font-serif": "ui-serif, Georgia, Cambria, \"Times New Roman\", Times, serif",
      "radius": "0.5rem",
      "tracking-tighter": "calc(var(--tracking-normal) - 0.05em)",
      "tracking-tight": "calc(var(--tracking-normal) - 0.025em)",
      "tracking-wide": "calc(var(--tracking-normal) + 0.025em)",
      "tracking-wider": "calc(var(--tracking-normal) + 0.05em)",
      "tracking-widest": "calc(var(--tracking-normal) + 0.1em)"
    },
    "light": {
      "background": "{{ bright_foreground | oklch }}",
      "foreground": "{{ background | oklch }}",
      "card": "{{ light_foreground | oklch }}",
      "card-foreground": "{{ background | oklch }}",
      "popover": "{{ bright_foreground | oklch }}",
      "popover-foreground": "{{ background | oklch }}",
      "primary": "{{ brown | oklch }}",
      "primary-foreground": "{{ bright_foreground | oklch }}",
      "secondary": "{{ foreground | oklch }}",
      "secondary-foreground": "{{ background | oklch }}",
      "muted": "{{ light_foreground | oklch }}",
      "muted-foreground": "{{ muted | oklch }}",
      "accent": "{{ selection | oklch }}",
      "accent-foreground": "{{ bright_foreground | oklch }}",
      "destructive": "{{ deepOxblood | oklch }}",
      "destructive-foreground": "{{ bright_foreground | oklch }}",
      "border": "{{ muted | oklch }}",
      "input": "{{ muted | oklch }}",
      "ring": "{{ brown | oklch }}",
      "chart-1": "{{ accent | oklch }}",
      "chart-2": "{{ orange | oklch }}",
      "chart-3": "{{ green | oklch }}",
      "chart-4": "{{ cyan | oklch }}",
      "chart-5": "{{ blue | oklch }}",
      "radius": "0.5rem",
      "sidebar": "{{ light_foreground | oklch }}",
      "sidebar-foreground": "{{ background | oklch }}",
      "sidebar-primary": "{{ brown | oklch }}",
      "sidebar-primary-foreground": "{{ bright_foreground | oklch }}",
      "sidebar-accent": "{{ foreground | oklch }}",
      "sidebar-accent-foreground": "{{ background | oklch }}",
      "sidebar-border": "{{ muted | oklch }}",
      "sidebar-ring": "{{ brown | oklch }}",
      "font-sans": "ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, 'Noto Sans', sans-serif, 'Apple Color Emoji', 'Segoe UI Emoji', 'Segoe UI Symbol', 'Noto Color Emoji'",
      "font-serif": "ui-serif, Georgia, Cambria, \"Times New Roman\", Times, serif",
      "font-mono": "ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, \"Liberation Mono\", \"Courier New\", monospace",
      "shadow-color": "oklch(0 0 0)",
      "shadow-opacity": "0.1",
      "shadow-blur": "3px",
      "shadow-spread": "0px",
      "shadow-offset-x": "0",
      "shadow-offset-y": "1px",
      "letter-spacing": "0em",
      "spacing": "0.25rem",
      "shadow-2xs": "0 1px 3px 0px hsl(0 0% 0% / 0.05)",
      "shadow-xs": "0 1px 3px 0px hsl(0 0% 0% / 0.05)",
      "shadow-sm": "0 1px 3px 0px hsl(0 0% 0% / 0.10), 0 1px 2px -1px hsl(0 0% 0% / 0.10)",
      "shadow": "0 1px 3px 0px hsl(0 0% 0% / 0.10), 0 1px 2px -1px hsl(0 0% 0% / 0.10)",
      "shadow-md": "0 1px 3px 0px hsl(0 0% 0% / 0.10), 0 2px 4px -1px hsl(0 0% 0% / 0.10)",
      "shadow-lg": "0 1px 3px 0px hsl(0 0% 0% / 0.10), 0 4px 6px -1px hsl(0 0% 0% / 0.10)",
      "shadow-xl": "0 1px 3px 0px hsl(0 0% 0% / 0.10), 0 8px 10px -1px hsl(0 0% 0% / 0.10)",
      "shadow-2xl": "0 1px 3px 0px hsl(0 0% 0% / 0.25)",
      "tracking-normal": "0em"
    },
    "dark": {
      "background": "{{ background | oklch }}",
      "foreground": "{{ foreground | oklch }}",
      "card": "{{ lighter_background | oklch }}",
      "card-foreground": "{{ light_foreground | oklch }}",
      "popover": "{{ lighter_background | oklch }}",
      "popover-foreground": "{{ light_foreground | oklch }}",
      "primary": "{{ accent | oklch }}",
      "primary-foreground": "{{ darker_background | oklch }}",
      "secondary": "{{ selection | oklch }}",
      "secondary-foreground": "{{ light_foreground | oklch }}",
      "muted": "{{ lighter_background | oklch }}",
      "muted-foreground": "{{ mutedTaupe | oklch }}",
      "accent": "{{ selection | oklch }}",
      "accent-foreground": "{{ bright_foreground | oklch }}",
      "destructive": "{{ red | oklch }}",
      "destructive-foreground": "{{ darker_background | oklch }}",
      "border": "{{ muted | oklch }}",
      "input": "{{ muted | oklch }}",
      "ring": "{{ accent | oklch }}",
      "chart-1": "{{ accent | oklch }}",
      "chart-2": "{{ orange | oklch }}",
      "chart-3": "{{ green | oklch }}",
      "chart-4": "{{ cyan | oklch }}",
      "chart-5": "{{ blue | oklch }}",
      "radius": "0.5rem",
      "sidebar": "{{ background | oklch }}",
      "sidebar-foreground": "{{ foreground | oklch }}",
      "sidebar-primary": "{{ accent | oklch }}",
      "sidebar-primary-foreground": "{{ darker_background | oklch }}",
      "sidebar-accent": "{{ selection | oklch }}",
      "sidebar-accent-foreground": "{{ bright_foreground | oklch }}",
      "sidebar-border": "{{ muted | oklch }}",
      "sidebar-ring": "{{ accent | oklch }}",
      "font-sans": "ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, 'Noto Sans', sans-serif, 'Apple Color Emoji', 'Segoe UI Emoji', 'Segoe UI Symbol', 'Noto Color Emoji'",
      "font-serif": "ui-serif, Georgia, Cambria, \"Times New Roman\", Times, serif",
      "font-mono": "ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, \"Liberation Mono\", \"Courier New\", monospace",
      "shadow-color": "oklch(0 0 0)",
      "shadow-opacity": "0.1",
      "shadow-blur": "3px",
      "shadow-spread": "0px",
      "shadow-offset-x": "0",
      "shadow-offset-y": "1px",
      "letter-spacing": "0em",
      "spacing": "0.25rem",
      "shadow-2xs": "0 1px 3px 0px hsl(0 0% 0% / 0.05)",
      "shadow-xs": "0 1px 3px 0px hsl(0 0% 0% / 0.05)",
      "shadow-sm": "0 1px 3px 0px hsl(0 0% 0% / 0.10), 0 1px 2px -1px hsl(0 0% 0% / 0.10)",
      "shadow": "0 1px 3px 0px hsl(0 0% 0% / 0.10), 0 1px 2px -1px hsl(0 0% 0% / 0.10)",
      "shadow-md": "0 1px 3px 0px hsl(0 0% 0% / 0.10), 0 2px 4px -1px hsl(0 0% 0% / 0.10)",
      "shadow-lg": "0 1px 3px 0px hsl(0 0% 0% / 0.10), 0 4px 6px -1px hsl(0 0% 0% / 0.10)",
      "shadow-xl": "0 1px 3px 0px hsl(0 0% 0% / 0.10), 0 8px 10px -1px hsl(0 0% 0% / 0.10)",
      "shadow-2xl": "0 1px 3px 0px hsl(0 0% 0% / 0.25)"
    }
  },
  "css": {
    "@layer base": {
      "body": {
        "letter-spacing": "var(--tracking-normal)"
      }
    }
  },
  "type": "registry:style"
}
