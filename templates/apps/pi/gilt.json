    "toolDiffContext": "darkForeground",
    "syntaxComment": "{{ comment }}",
    "syntaxKeyword": "{{ keyword }}",
    "syntaxFunction": "{{ function }}",
    "syntaxVariable": "{{ variable }}",
    "syntaxString": "{{ string }}",
    "syntaxNumber": "{{ number }}",
    "syntaxType": "{{ type }}",
    "syntaxOperator": "{{ operator }}",
    "syntaxPunctuation": "{{ punctuation }}",
    "thinkingOff": "dustyTaupe",
    "thinkingMinimal": "bronze",
    "thinkingLow": "copper",
    "thinkingMedium": "gold",
    "thinkingHigh": "brightGold",
    "thinkingXhigh": "brightVerdigris",
    "thinkingMax": "brightAmethyst",
