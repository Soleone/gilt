    "scrollbarThumb": "darkForeground",
    "searchMatchBg": "goldShadow",
    "searchMatchText": "brightGold",
    "userMessageBg": "raisedStone",
    "userMessageText": "lightParchment",
    "customMessageBg": "goldShadow",
    "customMessageText": "lightParchment",
    "customMessageLabel": "gold",
    "toolPendingBg": "raisedStone",
    "toolSuccessBg": "{{ diff_add_bg }}",
    "toolErrorBg": "{{ diff_remove_bg }}",
