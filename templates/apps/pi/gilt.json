{
  "$schema": "https://raw.githubusercontent.com/earendil-works/pi/main/packages/coding-agent/src/modes/interactive/theme/theme-schema.json",
  "name": "gilt",
  "appearance": "dark",
  "vars": {
    "obsidian": "{{ background }}",
    "deepObsidian": "{{ darker_background }}",
    "raisedStone": "{{ lighter_background }}",
    "parchment": "{{ foreground }}",
    "lightParchment": "{{ light_foreground }}",
    "ivory": "{{ bright_foreground }}",
    "darkForeground": "{{ dark_foreground }}",
    "mutedTaupe": "{{ mutedTaupe }}",
    "dustyTaupe": "{{ muted }}",
    "gold": "{{ accent }}",
    "goldShadow": "{{ selection }}",
    "oxblood": "{{ red }}",
    "brightOxblood": "{{ bright_red }}",
    "copper": "{{ orange }}",
    "jade": "{{ green }}",
    "brightJade": "{{ bright_green }}",
    "verdigris": "{{ cyan }}",
    "brightVerdigris": "{{ bright_cyan }}",
    "lapis": "{{ blue }}",
    "brightLapis": "{{ bright_blue }}",
    "amethyst": "{{ magenta }}",
    "brightAmethyst": "{{ bright_magenta }}",
    "bronze": "{{ brown }}",
    "brightGold": "{{ bright_yellow }}",
    "jadeSurface": "{{ jadeSurface }}",
    "oxbloodSurface": "{{ oxbloodSurface }}"
  },
  "colors": {
    "accent": "gold",
    "border": "{{ border }}",
    "borderAccent": "gold",
    "borderMuted": "goldShadow",
    "success": "{{ success }}",
