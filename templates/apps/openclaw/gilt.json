{
  "name": "Gilt",
  "description": "Cool obsidian, warm parchment, and sovereign gold, with restrained jewel tones. Includes the original dark palette and a parchment light variant.",
  "light": {
    "background": "{{ bright_foreground }}",
    "foreground": "{{ background }}",
    "card": "{{ light_foreground }}",
    "card-foreground": "{{ background }}",
    "popover": "{{ bright_foreground }}",
    "popover-foreground": "{{ background }}",
    "primary": "{{ brown }}",
    "primary-foreground": "{{ bright_foreground }}",
    "secondary": "{{ foreground }}",
    "secondary-foreground": "{{ background }}",
    "muted": "{{ light_foreground }}",
    "muted-foreground": "{{ muted | mix(background, 0.1) }}",
    "accent": "{{ selection }}",
    "accent-foreground": "{{ bright_foreground }}",
    "destructive": "{{ deepOxblood }}",
    "destructive-foreground": "{{ bright_foreground }}",
    "border": "{{ muted }}",
    "input": "{{ muted }}",
    "ring": "{{ brown }}",
    "font-sans": "ui-sans-serif, system-ui, sans-serif",
    "font-mono": "ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace"
  },
  "dark": {
    "background": "{{ background }}",
    "foreground": "{{ foreground }}",
    "card": "{{ lighter_background }}",
    "card-foreground": "{{ light_foreground }}",
    "popover": "{{ lighter_background }}",
    "popover-foreground": "{{ light_foreground }}",
    "primary": "{{ accent }}",
    "primary-foreground": "{{ darker_background }}",
    "secondary": "{{ selection }}",
    "secondary-foreground": "{{ light_foreground }}",
    "muted": "{{ lighter_background }}",
    "muted-foreground": "{{ mutedTaupe }}",
    "accent": "{{ selection }}",
    "accent-foreground": "{{ bright_foreground }}",
    "destructive": "{{ red }}",
    "destructive-foreground": "{{ darker_background }}",
    "border": "{{ muted }}",
    "input": "{{ muted }}",
    "ring": "{{ accent }}",
    "font-sans": "ui-sans-serif, system-ui, sans-serif",
    "font-mono": "ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace"
  }
}
