{
  "$schema": "vscode://schemas/color-theme",
  "name": "Gilt",
  "type": "dark",
  "semanticHighlighting": true,
  "colors": {
    "foreground": "{{ foreground }}",
    "descriptionForeground": "{{ dim_text }}",
    "errorForeground": "{{ error }}",
    "focusBorder": "{{ accent | alpha(0.6) }}",
    "widget.shadow": "{{ darker_background | alpha(0.6) }}",
    "textLink.foreground": "{{ link }}",
    "textLink.activeForeground": "{{ link_url }}",
    "selection.background": "{{ selection_bg }}",

    "button.background": "{{ accent }}",
    "button.foreground": "{{ background }}",
    "button.hoverBackground": "{{ bright_yellow }}",
    "button.secondaryBackground": "{{ lighter_background }}",
    "button.secondaryForeground": "{{ foreground }}",
    "badge.background": "{{ accent }}",
    "badge.foreground": "{{ background }}",
    "input.background": "{{ lighter_background }}",
    "input.border": "{{ border }}",
    "input.foreground": "{{ foreground }}",
    "input.placeholderForeground": "{{ dim_text }}",
    "inputOption.activeBorder": "{{ accent }}",
    "dropdown.background": "{{ lighter_background }}",
    "dropdown.border": "{{ border }}",
    "scrollbarSlider.background": "{{ dark_foreground | alpha(0.35) }}",
    "scrollbarSlider.hoverBackground": "{{ dark_foreground | alpha(0.55) }}",
    "scrollbarSlider.activeBackground": "{{ dark_foreground | alpha(0.75) }}",

    "titleBar.activeBackground": "{{ dark_background }}",
    "titleBar.activeForeground": "{{ light_foreground }}",
    "titleBar.inactiveBackground": "{{ dark_background }}",
    "titleBar.inactiveForeground": "{{ dim_text }}",
    "activityBar.background": "{{ dark_background }}",
    "activityBar.foreground": "{{ light_foreground }}",
    "activityBar.inactiveForeground": "{{ muted }}",
    "activityBar.activeBorder": "{{ accent }}",
    "activityBarBadge.background": "{{ accent }}",
    "activityBarBadge.foreground": "{{ background }}",
    "sideBar.background": "{{ dark_background }}",
    "sideBar.foreground": "{{ foreground }}",
    "sideBar.border": "{{ dark_background }}",
    "sideBarTitle.foreground": "{{ light_foreground }}",
    "sideBarSectionHeader.background": "{{ dark_background }}",
    "sideBarSectionHeader.foreground": "{{ light_foreground }}",
    "list.activeSelectionBackground": "{{ selection_bg }}",
    "list.activeSelectionForeground": "{{ selection_fg }}",
    "list.inactiveSelectionBackground": "{{ lighter_background }}",
    "list.hoverBackground": "{{ lighter_background }}",
    "list.highlightForeground": "{{ accent }}",
    "list.focusOutline": "{{ accent | alpha(0.6) }}",
    "statusBar.background": "{{ dark_background }}",
    "statusBar.foreground": "{{ foreground }}",
    "statusBar.border": "{{ dark_background }}",
    "statusBar.noFolderBackground": "{{ dark_background }}",
    "statusBar.debuggingBackground": "{{ orange }}",
    "statusBar.debuggingForeground": "{{ background }}",
    "statusBarItem.remoteBackground": "{{ accent }}",
    "statusBarItem.remoteForeground": "{{ background }}",
    "editorGroupHeader.tabsBackground": "{{ dark_background }}",
    "tab.activeBackground": "{{ background }}",
    "tab.activeForeground": "{{ light_foreground }}",
    "tab.activeBorderTop": "{{ accent }}",
    "tab.inactiveBackground": "{{ dark_background }}",
    "tab.inactiveForeground": "{{ dim_text }}",
    "tab.border": "{{ dark_background }}",
    "breadcrumb.foreground": "{{ dim_text }}",
    "breadcrumb.focusForeground": "{{ light_foreground }}",
    "breadcrumb.activeSelectionForeground": "{{ accent }}",
    "panel.background": "{{ dark_background }}",
    "panel.border": "{{ split }}",
    "panelTitle.activeForeground": "{{ light_foreground }}",
    "panelTitle.activeBorder": "{{ accent }}",
    "panelTitle.inactiveForeground": "{{ dim_text }}",
    "notifications.background": "{{ lighter_background }}",
    "notifications.border": "{{ border }}",
    "quickInput.background": "{{ lighter_background }}",
    "quickInputList.focusBackground": "{{ selection_bg }}",
    "pickerGroup.foreground": "{{ accent }}",
    "menu.background": "{{ lighter_background }}",
    "menu.foreground": "{{ foreground }}",
    "menu.selectionBackground": "{{ selection_bg }}",

    "editor.background": "{{ background }}",
    "editor.foreground": "{{ foreground }}",
    "editorCursor.foreground": "{{ cursor }}",
    "editor.lineHighlightBackground": "{{ cursorline }}",
    "editor.selectionBackground": "{{ selection_bg }}",
    "editor.inactiveSelectionBackground": "{{ selection_bg | alpha(0.6) }}",
    "editor.selectionHighlightBackground": "{{ lighter_background }}",
    "editor.wordHighlightBackground": "{{ lighter_background }}",
    "editor.wordHighlightStrongBackground": "{{ selection_bg }}",
    "editor.findMatchBackground": "{{ accent | alpha(0.4) }}",
    "editor.findMatchHighlightBackground": "{{ selection_bg }}",
    "editorLineNumber.foreground": "{{ muted }}",
    "editorLineNumber.activeForeground": "{{ accent }}",
    "editorIndentGuide.background1": "{{ split | mix(background, 0.5) }}",
    "editorIndentGuide.activeBackground1": "{{ split }}",
    "editorWhitespace.foreground": "{{ split }}",
    "editorRuler.foreground": "{{ lighter_background }}",
    "editorBracketMatch.background": "{{ selection_bg }}",
    "editorBracketMatch.border": "{{ accent }}",
    "editorLink.activeForeground": "{{ link }}",
    "editorInlayHint.foreground": "{{ dark_foreground }}",
    "editorInlayHint.background": "{{ lighter_background | alpha(0.6) }}",
    "editorGhostText.foreground": "{{ dark_foreground }}",
    "editorStickyScroll.background": "{{ background }}",
    "editorOverviewRuler.border": "{{ background }}",
    "editorGutter.addedBackground": "{{ diff_add_fg }}",
    "editorGutter.modifiedBackground": "{{ info }}",
    "editorGutter.deletedBackground": "{{ diff_remove_fg }}",
    "editorError.foreground": "{{ error }}",
    "editorWarning.foreground": "{{ warning }}",
    "editorInfo.foreground": "{{ info }}",
    "editorHint.foreground": "{{ dim_text }}",
    "editorWidget.background": "{{ lighter_background }}",
    "editorWidget.border": "{{ border }}",
    "editorSuggestWidget.background": "{{ lighter_background }}",
    "editorSuggestWidget.border": "{{ border }}",
    "editorSuggestWidget.foreground": "{{ foreground }}",
    "editorSuggestWidget.selectedBackground": "{{ selection_bg }}",
    "editorSuggestWidget.highlightForeground": "{{ accent }}",
    "editorHoverWidget.background": "{{ lighter_background }}",
    "editorHoverWidget.border": "{{ border }}",
    "peekView.border": "{{ accent }}",
    "peekViewEditor.background": "{{ dark_background }}",
    "peekViewResult.background": "{{ lighter_background }}",
    "peekViewTitle.background": "{{ lighter_background }}",

    "diffEditor.insertedLineBackground": "{{ diff_add_bg }}",
    "diffEditor.removedLineBackground": "{{ diff_remove_bg }}",
    "diffEditor.insertedTextBackground": "{{ diff_add_fg | alpha(0.25) }}",
    "diffEditor.removedTextBackground": "{{ diff_remove_fg | alpha(0.25) }}",
    "gitDecoration.addedResourceForeground": "{{ success }}",
    "gitDecoration.untrackedResourceForeground": "{{ success }}",
    "gitDecoration.modifiedResourceForeground": "{{ warning }}",
    "gitDecoration.deletedResourceForeground": "{{ error }}",
    "gitDecoration.conflictingResourceForeground": "{{ magenta }}",
    "gitDecoration.ignoredResourceForeground": "{{ muted }}",

    "terminal.background": "{{ background }}",
    "terminal.foreground": "{{ foreground }}",
    "terminal.selectionBackground": "{{ selection_bg }}",
    "terminalCursor.foreground": "{{ cursor }}",
    "terminal.ansiBlack": "{{ ansi0 }}",
    "terminal.ansiRed": "{{ ansi1 }}",
    "terminal.ansiGreen": "{{ ansi2 }}",
    "terminal.ansiYellow": "{{ ansi3 }}",
    "terminal.ansiBlue": "{{ ansi4 }}",
    "terminal.ansiMagenta": "{{ ansi5 }}",
    "terminal.ansiCyan": "{{ ansi6 }}",
    "terminal.ansiWhite": "{{ ansi7 }}",
    "terminal.ansiBrightBlack": "{{ ansi8 }}",
    "terminal.ansiBrightRed": "{{ ansi9 }}",
    "terminal.ansiBrightGreen": "{{ ansi10 }}",
    "terminal.ansiBrightYellow": "{{ ansi11 }}",
    "terminal.ansiBrightBlue": "{{ ansi12 }}",
    "terminal.ansiBrightMagenta": "{{ ansi13 }}",
    "terminal.ansiBrightCyan": "{{ ansi14 }}",
    "terminal.ansiBrightWhite": "{{ ansi15 }}"
  },
  "tokenColors": [
    { "scope": ["comment", "punctuation.definition.comment"], "settings": { "foreground": "{{ comment }}", "fontStyle": "italic" } },
    { "scope": ["keyword", "keyword.control", "storage.type", "storage.modifier", "keyword.operator.new", "keyword.operator.expression", "keyword.operator.logical.python", "entity.name.tag"], "settings": { "foreground": "{{ keyword }}" } },
    { "scope": ["keyword.operator", "punctuation.separator.key-value"], "settings": { "foreground": "{{ operator }}" } },
    { "scope": ["entity.name.function", "support.function", "meta.function-call", "meta.decorator", "entity.name.function.decorator"], "settings": { "foreground": "{{ function }}" } },
    { "scope": ["variable", "variable.other", "variable.parameter", "meta.definition.variable", "variable.other.property", "support.variable.property", "variable.other.object.property", "entity.other.attribute-name", "support.type.property-name"], "settings": { "foreground": "{{ variable }}" } },
    { "scope": ["variable.language", "support.variable", "entity.name.function.macro"], "settings": { "foreground": "{{ builtin }}" } },
    { "scope": ["string", "punctuation.definition.string"], "settings": { "foreground": "{{ string }}" } },
    { "scope": ["constant.numeric"], "settings": { "foreground": "{{ number }}" } },
    { "scope": ["constant.language", "support.constant", "variable.other.constant", "variable.other.enummember"], "settings": { "foreground": "{{ constant }}" } },
    { "scope": ["constant.character.escape", "string.regexp", "constant.other.placeholder", "punctuation.definition.template-expression"], "settings": { "foreground": "{{ escape }}" } },
    { "scope": ["entity.name.type", "entity.name.class", "support.type", "support.class", "entity.other.inherited-class", "entity.name.namespace", "entity.name.module"], "settings": { "foreground": "{{ type }}" } },
    { "scope": ["punctuation", "meta.brace"], "settings": { "foreground": "{{ punctuation }}" } },
    { "scope": ["markup.heading", "entity.name.section"], "settings": { "foreground": "{{ heading }}", "fontStyle": "bold" } },
    { "scope": ["markup.bold"], "settings": { "fontStyle": "bold" } },
    { "scope": ["markup.italic"], "settings": { "fontStyle": "italic" } },
    { "scope": ["markup.underline.link", "markup.link"], "settings": { "foreground": "{{ link_url }}" } },
    { "scope": ["string.other.link.title", "string.other.link.description"], "settings": { "foreground": "{{ link }}" } },
    { "scope": ["markup.inline.raw", "markup.fenced_code", "markup.raw"], "settings": { "foreground": "{{ code }}" } },
    { "scope": ["markup.quote"], "settings": { "foreground": "{{ quote }}", "fontStyle": "italic" } },
    { "scope": ["markup.list", "punctuation.definition.list"], "settings": { "foreground": "{{ code }}" } },
    { "scope": ["markup.inserted"], "settings": { "foreground": "{{ diff_add_fg }}" } },
    { "scope": ["markup.deleted"], "settings": { "foreground": "{{ diff_remove_fg }}" } },
    { "scope": ["markup.changed"], "settings": { "foreground": "{{ info }}" } },
    { "scope": ["invalid", "invalid.illegal"], "settings": { "foreground": "{{ error }}" } }
  ],
  "semanticTokenColors": {
    "variable": "{{ variable }}",
    "parameter": "{{ variable }}",
    "property": "{{ variable }}",
    "function": "{{ function }}",
    "method": "{{ function }}",
    "decorator": "{{ function }}",
    "type": "{{ type }}",
    "class": "{{ type }}",
    "interface": "{{ type }}",
    "enum": "{{ type }}",
    "struct": "{{ type }}",
    "typeParameter": "{{ type }}",
    "namespace": "{{ type }}",
    "enumMember": "{{ constant }}",
    "keyword": "{{ keyword }}",
    "macro": "{{ builtin }}",
    "selfKeyword": "{{ builtin }}",
    "variable.defaultLibrary": "{{ builtin }}",
    "variable.readonly.defaultLibrary": "{{ builtin }}",
    "*.deprecated": { "strikethrough": true }
  }
}
