{
  "$schema": "vscode://schemas/color-theme",
  "name": "Gilt",
  "type": "dark",
  "semanticHighlighting": true,
  "colors": {
    "foreground": "#D8D1C0",
    "descriptionForeground": "#918977",
    "errorForeground": "#D47474",
    "focusBorder": "#D4AF3799",
    "widget.shadow": "#05060799",
    "textLink.foreground": "#8FAECC",
    "textLink.activeForeground": "#91C0BD",
    "selection.background": "#342D1B",

    "button.background": "#D4AF37",
    "button.foreground": "#0D0F12",
    "button.hoverBackground": "#E7C968",
    "button.secondaryBackground": "#181B20",
    "button.secondaryForeground": "#D8D1C0",
    "badge.background": "#D4AF37",
    "badge.foreground": "#0D0F12",
    "input.background": "#181B20",
    "input.border": "#716957",
    "input.foreground": "#D8D1C0",
    "input.placeholderForeground": "#918977",
    "inputOption.activeBorder": "#D4AF37",
    "dropdown.background": "#181B20",
    "dropdown.border": "#716957",
    "scrollbarSlider.background": "#7B746559",
    "scrollbarSlider.hoverBackground": "#7B74658C",
    "scrollbarSlider.activeBackground": "#7B7465BF",

    "titleBar.activeBackground": "#090A0C",
    "titleBar.activeForeground": "#E6DECB",
    "titleBar.inactiveBackground": "#090A0C",
    "titleBar.inactiveForeground": "#918977",
    "activityBar.background": "#090A0C",
    "activityBar.foreground": "#E6DECB",
    "activityBar.inactiveForeground": "#716957",
    "activityBar.activeBorder": "#D4AF37",
    "activityBarBadge.background": "#D4AF37",
    "activityBarBadge.foreground": "#0D0F12",
    "sideBar.background": "#090A0C",
    "sideBar.foreground": "#D8D1C0",
    "sideBar.border": "#090A0C",
    "sideBarTitle.foreground": "#E6DECB",
    "sideBarSectionHeader.background": "#090A0C",
    "sideBarSectionHeader.foreground": "#E6DECB",
    "list.activeSelectionBackground": "#342D1B",
    "list.activeSelectionForeground": "#F5EBD2",
    "list.inactiveSelectionBackground": "#181B20",
    "list.hoverBackground": "#181B20",
    "list.highlightForeground": "#D4AF37",
    "list.focusOutline": "#D4AF3799",
    "statusBar.background": "#090A0C",
    "statusBar.foreground": "#D8D1C0",
    "statusBar.border": "#090A0C",
    "statusBar.noFolderBackground": "#090A0C",
    "statusBar.debuggingBackground": "#C27B48",
    "statusBar.debuggingForeground": "#0D0F12",
    "statusBarItem.remoteBackground": "#D4AF37",
    "statusBarItem.remoteForeground": "#0D0F12",
    "editorGroupHeader.tabsBackground": "#090A0C",
    "tab.activeBackground": "#0D0F12",
    "tab.activeForeground": "#E6DECB",
    "tab.activeBorderTop": "#D4AF37",
    "tab.inactiveBackground": "#090A0C",
    "tab.inactiveForeground": "#918977",
    "tab.border": "#090A0C",
    "breadcrumb.foreground": "#918977",
    "breadcrumb.focusForeground": "#E6DECB",
    "breadcrumb.activeSelectionForeground": "#D4AF37",
    "panel.background": "#090A0C",
    "panel.border": "#4F4A3F",
    "panelTitle.activeForeground": "#E6DECB",
    "panelTitle.activeBorder": "#D4AF37",
    "panelTitle.inactiveForeground": "#918977",
    "notifications.background": "#181B20",
    "notifications.border": "#716957",
    "quickInput.background": "#181B20",
    "quickInputList.focusBackground": "#342D1B",
    "pickerGroup.foreground": "#D4AF37",
    "menu.background": "#181B20",
    "menu.foreground": "#D8D1C0",
    "menu.selectionBackground": "#342D1B",

    "editor.background": "#0D0F12",
    "editor.foreground": "#D8D1C0",
    "editorCursor.foreground": "#F5EBD2",
    "editor.lineHighlightBackground": "#131519",
    "editor.selectionBackground": "#342D1B",
    "editor.inactiveSelectionBackground": "#342D1B99",
    "editor.selectionHighlightBackground": "#181B20",
    "editor.wordHighlightBackground": "#181B20",
    "editor.wordHighlightStrongBackground": "#342D1B",
    "editor.findMatchBackground": "#D4AF3766",
    "editor.findMatchHighlightBackground": "#342D1B",
    "editorLineNumber.foreground": "#716957",
    "editorLineNumber.activeForeground": "#D4AF37",
    "editorIndentGuide.background1": "#2E2C28",
    "editorIndentGuide.activeBackground1": "#4F4A3F",
    "editorWhitespace.foreground": "#4F4A3F",
    "editorRuler.foreground": "#181B20",
    "editorBracketMatch.background": "#342D1B",
    "editorBracketMatch.border": "#D4AF37",
    "editorLink.activeForeground": "#8FAECC",
    "editorInlayHint.foreground": "#7B7465",
    "editorInlayHint.background": "#181B2099",
    "editorGhostText.foreground": "#7B7465",
    "editorStickyScroll.background": "#0D0F12",
    "editorOverviewRuler.border": "#0D0F12",
    "editorGutter.addedBackground": "#9DBB8E",
    "editorGutter.modifiedBackground": "#8FAECC",
    "editorGutter.deletedBackground": "#D47474",
    "editorError.foreground": "#D47474",
    "editorWarning.foreground": "#E7C968",
    "editorInfo.foreground": "#8FAECC",
    "editorHint.foreground": "#918977",
    "editorWidget.background": "#181B20",
    "editorWidget.border": "#716957",
    "editorSuggestWidget.background": "#181B20",
    "editorSuggestWidget.border": "#716957",
    "editorSuggestWidget.foreground": "#D8D1C0",
    "editorSuggestWidget.selectedBackground": "#342D1B",
    "editorSuggestWidget.highlightForeground": "#D4AF37",
    "editorHoverWidget.background": "#181B20",
    "editorHoverWidget.border": "#716957",
    "peekView.border": "#D4AF37",
    "peekViewEditor.background": "#090A0C",
    "peekViewResult.background": "#181B20",
    "peekViewTitle.background": "#181B20",

    "diffEditor.insertedLineBackground": "#1E2A20",
    "diffEditor.removedLineBackground": "#2B1C1D",
    "diffEditor.insertedTextBackground": "#9DBB8E40",
    "diffEditor.removedTextBackground": "#D4747440",
    "gitDecoration.addedResourceForeground": "#9DBB8E",
    "gitDecoration.untrackedResourceForeground": "#9DBB8E",
    "gitDecoration.modifiedResourceForeground": "#E7C968",
    "gitDecoration.deletedResourceForeground": "#D47474",
    "gitDecoration.conflictingResourceForeground": "#9A7AA0",
    "gitDecoration.ignoredResourceForeground": "#716957",

    "terminal.background": "#0D0F12",
    "terminal.foreground": "#D8D1C0",
    "terminal.selectionBackground": "#342D1B",
    "terminalCursor.foreground": "#F5EBD2",
    "terminal.ansiBlack": "#181B20",
    "terminal.ansiRed": "#BC6060",
    "terminal.ansiGreen": "#7FA37A",
    "terminal.ansiYellow": "#D4AF37",
    "terminal.ansiBlue": "#6F8FAF",
    "terminal.ansiMagenta": "#9A7AA0",
    "terminal.ansiCyan": "#72A5A4",
    "terminal.ansiWhite": "#D8D1C0",
    "terminal.ansiBrightBlack": "#716957",
    "terminal.ansiBrightRed": "#D47474",
    "terminal.ansiBrightGreen": "#9DBB8E",
    "terminal.ansiBrightYellow": "#E7C968",
    "terminal.ansiBrightBlue": "#8FAECC",
    "terminal.ansiBrightMagenta": "#B596B8",
    "terminal.ansiBrightCyan": "#91C0BD",
    "terminal.ansiBrightWhite": "#F5EBD2"
  },
  "tokenColors": [
    { "scope": ["comment", "punctuation.definition.comment"], "settings": { "foreground": "#918977", "fontStyle": "italic" } },
    { "scope": ["keyword", "keyword.control", "storage.type", "storage.modifier", "keyword.operator.new", "keyword.operator.expression", "keyword.operator.logical.python", "entity.name.tag"], "settings": { "foreground": "#C27B48" } },
    { "scope": ["keyword.operator", "punctuation.separator.key-value"], "settings": { "foreground": "#E6DECB" } },
    { "scope": ["entity.name.function", "support.function", "meta.function-call", "meta.decorator", "entity.name.function.decorator"], "settings": { "foreground": "#F5EBD2" } },
    { "scope": ["variable", "variable.other", "variable.parameter", "meta.definition.variable", "variable.other.property", "support.variable.property", "variable.other.object.property", "entity.other.attribute-name", "support.type.property-name"], "settings": { "foreground": "#6F8FAF" } },
    { "scope": ["variable.language", "support.variable", "entity.name.function.macro"], "settings": { "foreground": "#9A7AA0" } },
    { "scope": ["string", "punctuation.definition.string"], "settings": { "foreground": "#7FA37A" } },
    { "scope": ["constant.numeric"], "settings": { "foreground": "#7FA37A" } },
    { "scope": ["constant.language", "support.constant", "variable.other.constant", "variable.other.enummember"], "settings": { "foreground": "#7FA37A" } },
    { "scope": ["constant.character.escape", "string.regexp", "constant.other.placeholder", "punctuation.definition.template-expression"], "settings": { "foreground": "#E7C968" } },
    { "scope": ["entity.name.type", "entity.name.class", "support.type", "support.class", "entity.other.inherited-class", "entity.name.namespace", "entity.name.module"], "settings": { "foreground": "#D4AF37" } },
    { "scope": ["punctuation", "meta.brace"], "settings": { "foreground": "#7B7465" } },
    { "scope": ["markup.heading", "entity.name.section"], "settings": { "foreground": "#D4AF37", "fontStyle": "bold" } },
    { "scope": ["markup.bold"], "settings": { "fontStyle": "bold" } },
    { "scope": ["markup.italic"], "settings": { "fontStyle": "italic" } },
    { "scope": ["markup.underline.link", "markup.link"], "settings": { "foreground": "#91C0BD" } },
    { "scope": ["string.other.link.title", "string.other.link.description"], "settings": { "foreground": "#8FAECC" } },
    { "scope": ["markup.inline.raw", "markup.fenced_code", "markup.raw"], "settings": { "foreground": "#C27B48" } },
    { "scope": ["markup.quote"], "settings": { "foreground": "#E6DECB", "fontStyle": "italic" } },
    { "scope": ["markup.list", "punctuation.definition.list"], "settings": { "foreground": "#C27B48" } },
    { "scope": ["markup.inserted"], "settings": { "foreground": "#9DBB8E" } },
    { "scope": ["markup.deleted"], "settings": { "foreground": "#D47474" } },
    { "scope": ["markup.changed"], "settings": { "foreground": "#8FAECC" } },
    { "scope": ["invalid", "invalid.illegal"], "settings": { "foreground": "#D47474" } }
  ],
  "semanticTokenColors": {
    "variable": "#6F8FAF",
    "parameter": "#6F8FAF",
    "property": "#6F8FAF",
    "function": "#F5EBD2",
    "method": "#F5EBD2",
    "decorator": "#F5EBD2",
    "type": "#D4AF37",
    "class": "#D4AF37",
    "interface": "#D4AF37",
    "enum": "#D4AF37",
    "struct": "#D4AF37",
    "typeParameter": "#D4AF37",
    "namespace": "#D4AF37",
    "enumMember": "#7FA37A",
    "keyword": "#C27B48",
    "macro": "#9A7AA0",
    "selfKeyword": "#9A7AA0",
    "variable.defaultLibrary": "#9A7AA0",
    "variable.readonly.defaultLibrary": "#9A7AA0",
    "*.deprecated": { "strikethrough": true }
  }
}
